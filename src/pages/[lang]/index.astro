---
import { getCollection } from "astro:content"
import CaseCard from "@/components/home/CaseCard.astro"
import Contact from "@/components/home/Contact.astro"
import ExperienceList from "@/components/home/ExperienceList.astro"
import Figures from "@/components/home/Figures.astro"
import Hero from "@/components/home/Hero.astro"
import SectionHeading from "@/components/home/SectionHeading.astro"
import WorkList from "@/components/home/WorkList.astro"
import Base from "@/layouts/Base.astro"
import { LOCALES, SECTION_IDS, type Lang } from "@/i18n/routes"
import { useTranslations } from "@/i18n/ui"

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Lang
const t = useTranslations(lang)
const ids = SECTION_IDS[lang]
const cases = (await getCollection("cases", ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
)
const section = "mx-auto max-w-[1200px] scroll-mt-20 px-5 pt-20 sm:px-8 sm:pt-28"
---

<Base lang={lang} person>
  <Hero lang={lang} />
  <Figures lang={lang} />

  <section id={ids.cases} class={section} aria-labelledby={`${ids.cases}-title`} data-section>
    <div id={`${ids.cases}-title`}><SectionHeading title={t("cases.title")} /></div>
    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {cases.map((entry, index) => <CaseCard entry={entry} featured={index === 0} />)}
    </div>
  </section>

  <section id={ids.experience} class={section} aria-labelledby={`${ids.experience}-title`} data-section>
    <div id={`${ids.experience}-title`}><SectionHeading title={t("experience.title")} /></div>
    <div class="mt-8"><ExperienceList lang={lang} /></div>
  </section>

  <section id={ids.work} class={section} aria-labelledby={`${ids.work}-title`} data-section>
    <div id={`${ids.work}-title`}><SectionHeading title={t("work.title")} /></div>
    <div class="mt-8"><WorkList lang={lang} /></div>
  </section>

  <section id={ids.contact} class={section} aria-labelledby={`${ids.contact}-title`} data-section>
    <div id={`${ids.contact}-title`}><SectionHeading title={t("contact.title")} /></div>
    <div class="mt-8"><Contact lang={lang} /></div>
  </section>
</Base>
