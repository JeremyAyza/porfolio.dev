---
import { Image } from "astro:assets"
import photo from "@/assets/jeremy-ayza.jpg"
import Icon from "@/components/Icon.astro"
import { HEADLINE, LOCATION, SITE } from "@/data/site"
import type { Lang } from "@/i18n/routes"
import { useTranslations } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section class="relative" data-chunk={SITE.name} id="top">
  <div class="dot-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto max-w-[1080px] px-5 pb-12 pt-12 sm:px-8 sm:pb-16 sm:pt-20">
    <div class="flex items-center gap-4">
      <Image
        src={photo}
        alt={t("hero.photoAlt")}
        width={64}
        height={64}
        densities={[1, 2, 3]}
        loading="eager"
        class="size-16 rounded-full border border-line object-cover"
      />
      <div>
        <p class="font-display text-lg font-bold leading-tight">{SITE.name}</p>
        <p class="label">{SITE.role} · {LOCATION[lang]}</p>
      </div>
    </div>

    <h1
      class="mt-8 max-w-4xl border-l-4 border-accent pl-5 font-display text-[clamp(1.75rem,4.6vw,3.25rem)] font-bold leading-[1.1] tracking-tight sm:pl-7"
    >
      {HEADLINE[lang].map((part) => (part.accent ? <span class="text-accent">{part.text}</span> : part.text))}
    </h1>

    <ul class="mt-8 flex flex-wrap gap-3">
      <li>
        <a class="btn" href={SITE.links.github} rel="noopener">GitHub <Icon name="arrow-up-right" size={16} /></a>
      </li>
      <li>
        <a class="btn" href={SITE.links.linkedin} rel="noopener">LinkedIn <Icon name="arrow-up-right" size={16} /></a>
      </li>
      <li>
        <a class="btn" href={`mailto:${SITE.email}`}><Icon name="mail" size={16} /> {SITE.email}</a>
      </li>
      <li>
        <a class="btn" href={SITE.links.cv} rel="noopener"><Icon name="download" size={16} /> {t("hero.cv")}</a>
      </li>
    </ul>
  </div>
</section>
