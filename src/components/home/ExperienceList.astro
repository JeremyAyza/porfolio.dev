---
import { EXPERIENCE } from "@/data/experience"
import type { Lang } from "@/i18n/routes"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<ol class="divide-y divide-line border-y border-line">
  {
    EXPERIENCE[lang].map((job) => (
      <li class="grid gap-x-8 gap-y-2 py-6 md:grid-cols-[12rem_minmax(0,1fr)]">
        <p class="label pt-1">{job.period}</p>
        <div>
          <h3 class="font-display text-lg font-bold leading-snug">
            {job.company}
            <span class="block font-sans text-[0.9375rem] font-normal text-muted">{job.role}</span>
          </h3>
          <ul class="mt-3 space-y-2 text-[0.9375rem]">
            {job.points.map((point) => (
              <li class="flex gap-3" data-chunk={`${job.company}: ${job.role}`}>
                <span class="mt-[0.7em] h-0.5 w-3 flex-none bg-accent" aria-hidden="true" />
                <span class="max-w-[70ch]" data-chunk-text>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>
