---
import { Image } from "astro:assets"
import insightos from "@/assets/projects/insightos.webp"
import minecraft from "@/assets/projects/minecraft.webp"
import Icon from "@/components/Icon.astro"
import { WORK } from "@/data/work"
import type { Lang } from "@/i18n/routes"
import { useTranslations } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const { groups, personal } = WORK[lang]
const SHOTS = { minecraft, insightos }
---

<div class="grid gap-x-12 gap-y-10 lg:grid-cols-3">
  {
    groups.map((group) => (
      <div>
        <h3 class="border-b border-line pb-2 font-mono text-sm text-accent">{group.title}</h3>
        <ul class="mt-5 space-y-7">
          {group.entries.map((entry) => (
            <li id={`work-${entry.id}`} data-chunk={entry.title}>
              <h4 class="font-semibold leading-snug">{entry.title}</h4>
              <p class="mt-1.5 text-[0.9375rem] text-muted" data-chunk-text>
                {entry.summary}
              </p>
              <p class="mt-2 font-mono text-xs leading-relaxed text-muted" data-chunk-text>
                {entry.stack.join(", ")}
              </p>
              {entry.status && <p class="mt-1 font-mono text-xs text-accent">{entry.status}</p>}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<h3 class="mt-14 font-display text-xl font-bold tracking-tight">{t("work.personal")}</h3>
<ul class="mt-5 grid gap-6 sm:grid-cols-2">
  {
    personal.map((project) => (
      <li id={`work-${project.id}`} data-chunk={project.title}>
        <Image
          src={SHOTS[project.id]}
          alt={t("work.shot", { name: project.title })}
          widths={[480, 800, 1200]}
          sizes="(min-width: 640px) 36rem, 100vw"
          class="aspect-video w-full rounded-xl border border-line object-cover object-left-top"
        />
        <h4 class="mt-4 font-semibold leading-snug">{project.title}</h4>
        <p class="mt-1.5 max-w-[65ch] text-[0.9375rem] text-muted" data-chunk-text>
          {project.summary}
        </p>
        <p class="mt-2 font-mono text-xs leading-relaxed text-muted" data-chunk-text>
          {project.stack.join(", ")}
        </p>
        <p class="mt-1 flex gap-5">
          <a class="link inline-flex min-h-11 items-center gap-1 text-sm" href={project.demo} rel="noopener">
            {t("work.demo")} <Icon name="arrow-up-right" size={14} />
          </a>
          <a class="link inline-flex min-h-11 items-center gap-1 text-sm" href={project.code} rel="noopener">
            {t("work.code")} <Icon name="arrow-up-right" size={14} />
          </a>
        </p>
      </li>
    ))
  }
</ul>
