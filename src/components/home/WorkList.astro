---
import Icon from "@/components/Icon.astro"
import { WORK, type WorkEntry } from "@/data/work"
import type { Lang } from "@/i18n/routes"
import { useTranslations } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

const groups: { title: string; entries: WorkEntry[] }[] = [
  { title: t("work.company"), entries: WORK[lang].company },
  { title: t("work.personal"), entries: WORK[lang].personal },
]
---

<div class="space-y-10">
  {
    groups.map((group) => (
      <div>
        <h3 class="label mb-2 uppercase tracking-widest">{group.title}</h3>
        <ul class="divide-y divide-line border-y border-line">
          {group.entries.map((entry) => (
            <li class="py-5" id={`work-${entry.id}`} data-chunk={entry.title}>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h4 class="font-medium">{entry.title}</h4>
                {entry.status && <p class="label">{entry.status}</p>}
              </div>
              <p class="mt-1 max-w-[75ch] text-[0.9375rem] text-muted">{entry.summary}</p>
              <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                <ul class="flex flex-wrap gap-1.5" data-chunk-skip>
                  {entry.stack.map((item) => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
                {entry.demo && (
                  <a class="link inline-flex items-center gap-1 text-sm" href={entry.demo} rel="noopener">
                    {t("work.demo")} <Icon name="arrow-up-right" size={14} />
                  </a>
                )}
                {entry.code && (
                  <a class="link inline-flex items-center gap-1 text-sm" href={entry.code} rel="noopener">
                    {t("work.code")} <Icon name="arrow-up-right" size={14} />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
