---
import type { Lang } from "@/i18n/routes"
import { clientStrings, useTranslations } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<p
  class="offline-status flex items-center gap-2 font-mono text-xs text-muted"
  data-offline-status
  data-state="pending"
  data-strings={JSON.stringify(clientStrings(lang, "offline."))}
  role="status"
>
  <span class="dot" aria-hidden="true"></span>
  <span data-offline-text>{t("offline.pending")}</span>
</p>

<style>
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 999px;
    border: 1.5px solid var(--muted);
  }

  [data-state="ready"] .dot {
    border-color: var(--accent);
    background-color: var(--accent);
  }

  [data-state="offline"] .dot {
    border-color: var(--ink);
    background-color: var(--ink);
  }
</style>
