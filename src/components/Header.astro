---
import Icon from "./Icon.astro"
import LangSwitch from "./LangSwitch.astro"
import ThemeToggle from "./ThemeToggle.astro"
import { SITE } from "@/data/site"
import { SECTION_IDS, homePath, type Lang } from "@/i18n/routes"
import { useTranslations } from "@/i18n/ui"

interface Props {
  lang: Lang
  /** Sección a marcar como activa fuera del inicio (por ejemplo, en la página de un caso). */
  current?: keyof (typeof SECTION_IDS)[Lang]
}

const { lang, current } = Astro.props
const t = useTranslations(lang)
const home = homePath(lang)
const ids = SECTION_IDS[lang]

const links = (
  [
    ["cases", t("nav.cases")],
    ["experience", t("nav.experience")],
    ["work", t("nav.work")],
    ["contact", t("nav.contact")],
  ] as const
).map(([key, label]) => ({ id: ids[key], href: `${home}#${ids[key]}`, label, current: key === current }))
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-3 px-5 sm:px-8">
    <a href={home} class="flex min-h-11 items-center gap-2.5 font-display text-lg font-bold tracking-tight">
      <span class="h-5 w-1 bg-accent" aria-hidden="true"></span>
      {SITE.name}
    </a>

    <nav aria-label={t("nav.label")} class="hidden md:block">
      <ul class="flex items-center gap-6 font-mono text-sm text-muted">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link inline-flex min-h-11 items-center transition-colors hover:text-ink"
                data-nav={link.id}
                aria-current={link.current ? "true" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-search-open
        class="inline-flex h-11 items-center gap-2 rounded-lg px-2.5 font-mono text-sm text-muted transition-colors hover:text-ink"
      >
        <Icon name="search" />
        <span class="hidden sm:inline">{t("search.open")}</span>
        <kbd class="hidden rounded border border-line px-1.5 text-xs lg:inline" aria-hidden="true">/</kbd>
        <span class="sr-only sm:hidden">{t("search.open")}</span>
      </button>
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<script>
  // Marca en el menú la sección que se está leyendo.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")].map((link) => [link.dataset.nav, link]),
  )
  const sections = [...document.querySelectorAll<HTMLElement>("[data-section]")]

  if (sections.length > 0 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          for (const [id, link] of links) {
            if (id === entry.target.id) link.setAttribute("aria-current", "true")
            else link.removeAttribute("aria-current")
          }
        }
      },
      // Cuenta como activa la sección que cruza una franja en el tercio superior de la pantalla.
      { rootMargin: "-30% 0px -65% 0px" },
    )
    for (const section of sections) observer.observe(section)
  }
</script>
