---
import DiagramFigure from "./DiagramFigure.astro"
import type { Lang } from "@/i18n/routes"

interface Props {
  lang: Lang
}

const LABELS = {
  es: {
    caption: "Los cuatro pasos. Solo la búsqueda vectorial corre en el navegador.",
    desc: "Flujo de cuatro pasos: audio, transcripción con gpt-4o-mini-transcribe, búsqueda vectorial de candidatos y elección del producto con gpt-4o-mini. La búsqueda vectorial corre en el navegador, en un Web Worker, con Transformers.js y un índice Orama. La transcripción y la elección del producto necesitan conexión.",
    audio: "Audio",
    audioSub: "comando de voz",
    transcription: "Transcripción",
    search: "Búsqueda vectorial",
    index: "índice Orama",
    candidates: "candidatos",
    choice: "Elección del producto",
    online: "necesita conexión",
    local: ["en el navegador", "(Web Worker)"],
  },
  en: {
    caption: "The four steps. Only the vector search runs in the browser.",
    desc: "A flow with four steps: audio, transcription with gpt-4o-mini-transcribe, vector search for candidates, and product choice with gpt-4o-mini. The vector search runs in the browser, in a Web Worker, with Transformers.js and an Orama index. Transcription and product choice need a connection.",
    audio: "Audio",
    audioSub: "voice command",
    transcription: "Transcription",
    search: "Vector search",
    index: "Orama index",
    candidates: "candidates",
    choice: "Product choice",
    online: "needs connection",
    local: ["in the browser", "(Web Worker)"],
  },
} as const

const l = LABELS[Astro.props.lang]
---

<DiagramFigure caption={l.caption}>
  <svg
    class="dg mx-auto h-auto w-full max-w-[30rem]"
    viewBox="0 0 440 380"
    role="img"
    aria-labelledby="dg-voice-title dg-voice-desc"
  >
    <title id="dg-voice-title">{l.caption}</title>
    <desc id="dg-voice-desc">{l.desc}</desc>
    <defs>
      <marker id="dg-voice-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 10 5 0 10z" class="dg-head"></path>
      </marker>
    </defs>

    <g text-anchor="middle">
      <rect class="dg-box" x="30" y="8" width="270" height="50" rx="8"></rect>
      <text class="dg-t" x="165" y="30">{l.audio}</text>
      <text class="dg-s" x="165" y="47">{l.audioSub}</text>

      <path class="dg-wire" d="M165 58V84" marker-end="url(#dg-voice-arrow)"></path>

      <rect class="dg-box" x="30" y="86" width="270" height="50" rx="8"></rect>
      <text class="dg-t" x="165" y="108">{l.transcription}</text>
      <text class="dg-s" x="165" y="125">gpt-4o-mini-transcribe</text>

      <path class="dg-wire" d="M165 136V190" marker-end="url(#dg-voice-arrow)"></path>

      <rect class="dg-zone" x="14" y="172" width="302" height="110" rx="10"></rect>
      <rect class="dg-box-accent" x="30" y="192" width="270" height="72" rx="8"></rect>
      <text class="dg-t" x="165" y="215">{l.search}</text>
      <text class="dg-s" x="165" y="234">all-MiniLM-L6 · Transformers.js</text>
      <text class="dg-s" x="165" y="250">{l.index}</text>

      <path class="dg-wire" d="M165 264V318" marker-end="url(#dg-voice-arrow)"></path>

      <rect class="dg-box" x="30" y="320" width="270" height="50" rx="8"></rect>
      <text class="dg-t" x="165" y="342">{l.choice}</text>
      <text class="dg-s" x="165" y="359">gpt-4o-mini</text>
    </g>

    <text class="dg-s" x="312" y="115">{l.online}</text>
    <text class="dg-a" x="326" y="224">{l.local[0]}</text>
    <text class="dg-a" x="326" y="240">{l.local[1]}</text>
    <text class="dg-s" x="177" y="304">{l.candidates}</text>
    <text class="dg-s" x="312" y="349">{l.online}</text>
  </svg>
</DiagramFigure>
