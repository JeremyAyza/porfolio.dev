---
import DiagramFigure from "./DiagramFigure.astro"
import type { Lang } from "@/i18n/routes"

interface Props {
  lang: Lang
  bare?: boolean
}

interface Step {
  name: string
  sub?: string
  change?: { title: string; sub: string }
}

const LABELS: Record<Lang, { caption: string; desc: string; original: string; changed: string; steps: Step[] }> = {
  es: {
    caption: "Los 7 pasos del pipeline y los tres donde cambié algo.",
    desc: "El pipeline original tiene 7 pasos: guion, imágenes, voz, video, subtítulos, música y entrega. Cambié tres: en imágenes, un collage por escena y generación en Flow con Playwright y una extensión; en subtítulos, Whisper pasó de CPU a GPU; en entrega, subida automática y programada a YouTube.",
    original: "Pipeline original (7 pasos)",
    changed: "Lo que cambié",
    steps: [
      { name: "Guion", sub: "modelo de IA" },
      {
        name: "Imágenes",
        sub: "modelo de IA",
        change: { title: "1 collage por escena", sub: "Flow, Playwright, extensión" },
      },
      { name: "Voz", sub: "modelo de IA" },
      { name: "Video" },
      { name: "Subtítulos", sub: "Whisper", change: { title: "De CPU a GPU", sub: "whisper.cpp con CUDA" } },
      { name: "Música" },
      { name: "Entrega", change: { title: "Subida automática", sub: "programada en YouTube" } },
    ],
  },
  en: {
    caption: "The 7 pipeline steps, and the three where I changed something.",
    desc: "The original pipeline has 7 steps: script, images, voice, video, subtitles, music and delivery. I changed three: for images, one collage per scene and generation in Flow with Playwright and an extension; for subtitles, Whisper moved from CPU to GPU; for delivery, automatic scheduled upload to YouTube.",
    original: "Original pipeline (7 steps)",
    changed: "What I changed",
    steps: [
      { name: "Script", sub: "AI model" },
      {
        name: "Images",
        sub: "AI model",
        change: { title: "1 collage per scene", sub: "Flow, Playwright, extension" },
      },
      { name: "Voice", sub: "AI model" },
      { name: "Video" },
      { name: "Subtitles", sub: "Whisper", change: { title: "CPU to GPU", sub: "whisper.cpp with CUDA" } },
      { name: "Music" },
      { name: "Delivery", change: { title: "Automatic upload", sub: "scheduled on YouTube" } },
    ],
  },
}

const l = LABELS[Astro.props.lang]

// Los pasos van apilados. Los que cambié son más altos porque llevan el cambio adentro.
const PLAIN = 44
const CHANGED = 88
const GAP = 18
let cursor = 30
const rows = l.steps.map((step, index) => {
  const y = cursor
  const height = step.change ? CHANGED : PLAIN
  cursor += height + GAP
  return { ...step, y, height, number: String(index + 1).padStart(2, "0") }
})
const totalHeight = cursor - GAP + 8
---

<DiagramFigure caption={l.caption} bare={Astro.props.bare}>
  <svg
    class="dg mx-auto h-auto w-full max-w-[23rem]"
    viewBox={`0 0 320 ${totalHeight}`}
    role="img"
    aria-labelledby="dg-video-title dg-video-desc"
  >
    <title id="dg-video-title">{l.caption}</title>
    <desc id="dg-video-desc">{l.desc}</desc>
    <defs>
      <marker id="dg-video-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 10 5 0 10z" class="dg-head"></path>
      </marker>
    </defs>

    <text class="dg-s" x="6" y="16">{l.original}</text>
    <text class="dg-a" x="314" y="16" text-anchor="end">{l.changed}</text>

    {
      rows.map((row, index) => (
        <g>
          {index > 0 && <path class="dg-wire" d={`M160 ${row.y - GAP}V${row.y - 2}`} marker-end="url(#dg-video-arrow)" />}
          <rect class={row.change ? "dg-box-accent" : "dg-box"} x="6" y={row.y} width="308" height={row.height} rx="8" />
          <text class="dg-s" x="20" y={row.y + 27}>{row.number}</text>
          <text class="dg-t" x="48" y={row.sub ? row.y + 20 : row.y + 27}>{row.name}</text>
          {row.sub && <text class="dg-s" x="48" y={row.y + 36}>{row.sub}</text>}
          {row.change && (
            <>
              <path class="dg-rule" d={`M48 ${row.y + 46}H300`} />
              <text class="dg-at" x="48" y={row.y + 65}>{row.change.title}</text>
              <text class="dg-s" x="48" y={row.y + 81}>{row.change.sub}</text>
            </>
          )}
        </g>
      ))
    }
  </svg>
</DiagramFigure>
