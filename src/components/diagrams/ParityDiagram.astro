---
import DiagramFigure from "./DiagramFigure.astro"
import type { Lang } from "@/i18n/routes"

interface Props {
  lang: Lang
  bare?: boolean
}

const LABELS = {
  es: {
    caption: "La misma venta pasa por los dos sistemas y se comparan los payloads.",
    desc: "Una suite de Playwright ejecuta la misma venta en el POS legacy y en el POS nuevo. Captura el payload de cada uno y los compara campo por campo, ignorando fechas e IDs. Si son iguales la prueba pasa; si son distintos, falla.",
    sale: "La misma venta",
    saleSub: "suite E2E en Playwright",
    legacy: "POS legacy",
    legacySub: "flujo anterior",
    next: "POS nuevo",
    nextSub: "capa de dominio",
    payloadA: "Payload A",
    payloadB: "Payload B",
    captured: "capturado",
    compare: "Comparación campo por campo",
    compareSub: "se ignoran fechas e IDs",
    pass: "Iguales: pasa",
    fail: "Distintos: falla",
  },
  en: {
    caption: "The same sale goes through both systems, and the payloads are compared.",
    desc: "A Playwright suite runs the same sale on the old POS and on the new POS. It captures the payload of each one and compares them field by field, ignoring dates and IDs. If they are the same the test passes; if they are different, it fails.",
    sale: "The same sale",
    saleSub: "Playwright E2E suite",
    legacy: "Old POS",
    legacySub: "previous flow",
    next: "New POS",
    nextSub: "domain layer",
    payloadA: "Payload A",
    payloadB: "Payload B",
    captured: "captured",
    compare: "Field-by-field comparison",
    compareSub: "dates and IDs are ignored",
    pass: "Same: pass",
    fail: "Different: fail",
  },
} as const

const l = LABELS[Astro.props.lang]
---

<DiagramFigure caption={l.caption} bare={Astro.props.bare}>
  <svg
    class="dg mx-auto h-auto w-full max-w-[23rem]"
    viewBox="0 0 320 430"
    role="img"
    aria-labelledby="dg-parity-title dg-parity-desc"
  >
    <title id="dg-parity-title">{l.caption}</title>
    <desc id="dg-parity-desc">{l.desc}</desc>
    <defs>
      <marker id="dg-parity-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 10 5 0 10z" class="dg-head"></path>
      </marker>
    </defs>

    <g text-anchor="middle">
      <rect class="dg-box" x="66" y="8" width="188" height="48" rx="8"></rect>
      <text class="dg-t" x="160" y="29">{l.sale}</text>
      <text class="dg-s" x="160" y="46">{l.saleSub}</text>

      <path class="dg-wire" d="M160 56V78H80V100" marker-end="url(#dg-parity-arrow)"></path>
      <path class="dg-wire" d="M160 78H240V100" marker-end="url(#dg-parity-arrow)"></path>

      <rect class="dg-box" x="6" y="102" width="148" height="48" rx="8"></rect>
      <text class="dg-t" x="80" y="123">{l.legacy}</text>
      <text class="dg-s" x="80" y="140">{l.legacySub}</text>

      <rect class="dg-box" x="166" y="102" width="148" height="48" rx="8"></rect>
      <text class="dg-t" x="240" y="123">{l.next}</text>
      <text class="dg-s" x="240" y="140">{l.nextSub}</text>

      <path class="dg-wire" d="M80 150V178" marker-end="url(#dg-parity-arrow)"></path>
      <path class="dg-wire" d="M240 150V178" marker-end="url(#dg-parity-arrow)"></path>

      <rect class="dg-box" x="6" y="180" width="148" height="48" rx="8"></rect>
      <text class="dg-t" x="80" y="201">{l.payloadA}</text>
      <text class="dg-s" x="80" y="218">{l.captured}</text>

      <rect class="dg-box" x="166" y="180" width="148" height="48" rx="8"></rect>
      <text class="dg-t" x="240" y="201">{l.payloadB}</text>
      <text class="dg-s" x="240" y="218">{l.captured}</text>

      <path class="dg-wire" d="M80 228V252H160V274" marker-end="url(#dg-parity-arrow)"></path>
      <path class="dg-wire" d="M240 228V252H160"></path>

      <rect class="dg-box-accent" x="6" y="276" width="308" height="56" rx="8"></rect>
      <text class="dg-t" x="160" y="300">{l.compare}</text>
      <text class="dg-s" x="160" y="318">{l.compareSub}</text>

      <path class="dg-wire" d="M160 332V354H80V374" marker-end="url(#dg-parity-arrow)"></path>
      <path class="dg-wire" d="M160 354H240V374" marker-end="url(#dg-parity-arrow)"></path>

      <rect class="dg-box" x="6" y="376" width="148" height="44" rx="8"></rect>
      <text class="dg-t" x="80" y="402">{l.pass}</text>

      <rect class="dg-box" x="166" y="376" width="148" height="44" rx="8"></rect>
      <text class="dg-t" x="240" y="402">{l.fail}</text>
    </g>
  </svg>
</DiagramFigure>
