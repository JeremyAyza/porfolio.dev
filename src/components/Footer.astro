---
import OfflineStatus from "./OfflineStatus.astro"
import { SITE } from "@/data/site"
import type { Lang } from "@/i18n/routes"
import { useTranslations } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<footer class="mt-24 border-t border-line">
  <div
    class="mx-auto flex max-w-[1200px] flex-col gap-3 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <div class="space-y-1">
      <p class="font-mono text-xs text-muted">
        © 2026 {SITE.name}. {t("footer.built")}
        <a class="link" href={SITE.links.repo} rel="noopener">{t("footer.source")}</a>
      </p>
    </div>
    <OfflineStatus lang={lang} />
  </div>
</footer>
