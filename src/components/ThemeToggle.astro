---
import Icon from "./Icon.astro"
import type { Lang } from "@/i18n/routes"
import { useTranslations } from "@/i18n/ui"

interface Props {
  lang: Lang
}

const t = useTranslations(Astro.props.lang)
---

<button
  type="button"
  class="theme-toggle inline-flex size-11 items-center justify-center rounded-lg text-muted transition-colors hover:text-ink"
  data-theme-toggle
  data-to-light={t("theme.toLight")}
  data-to-dark={t("theme.toDark")}
  aria-label={t("theme.toLight")}
>
  <Icon name="sun" class="icon-sun" />
  <Icon name="moon" class="icon-moon" />
</button>


<script>
  const root = document.documentElement

  function sync(button: HTMLElement) {
    const isDark = root.dataset.theme !== "light"
    button.setAttribute("aria-label", (isDark ? button.dataset.toLight : button.dataset.toDark) ?? "")
  }

  for (const button of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
    sync(button)
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "light" ? "dark" : "light"
      root.dataset.theme = next
      try {
        localStorage.setItem("theme", next)
      } catch {
        // Sin almacenamiento el tema dura lo que dure la página.
      }
      sync(button)
    })
  }
</script>
